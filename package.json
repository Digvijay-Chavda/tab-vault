    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.8",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "minisearch": "^7.2.0"
  }
}
